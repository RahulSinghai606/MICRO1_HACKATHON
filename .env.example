# Copy to .env and fill in. Any OpenAI-compatible chat-completions endpoint works.
# Azure AI Foundry example:
#   LLM_BASE_URL=https://<your-resource>.services.ai.azure.com/openai/v1
#   LLM_API_KEY=<your-azure-key>
#   LLM_MODEL=<your-deployment-name>
# OpenAI example:
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_API_KEY=sk-...
#   LLM_MODEL=gpt-4o
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional. Only needed for --live-ocr (re-running OCR on invoice images).
# The repo ships with a committed OCR cache, so evaluation works without this.
MISTRAL_API_KEY=
